{
  "description": "After a file is written, checks it against the vault rules and refreshes INDEX.md. Does nothing outside a Bigin BA vault.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/bigin\" hook || python \"${CLAUDE_PLUGIN_ROOT}/bin/bigin\" hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
